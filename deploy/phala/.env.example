# Pin the released image by digest, never by a mutable tag.
METER_INGRESS_IMAGE=ghcr.io/adverserialai/confidential-meter-ingress@sha256:550c3f045ff8b3cb7becc87300e8339d758b627a1e4c6032eb6304feffcd742d

# Standard base64 encoding of the dedicated certificate material generated by
# confidential-infra/scripts/generate-meter-mtls-material.py. These are sealed
# by Phala at deployment and are never committed.
TLS_CERT_PEM_B64=
TLS_KEY_PEM_B64=
CLIENT_CA_PEM_B64=
EXPECTED_CLIENT_SPKI_SHA256=sha256:REPLACE_WITH_CVM_CLIENT_CERT_SPKI
BILLING_METER_URL=https://billing.adverserial.ai/cc/meter
BILLING_INGRESS_SECRET=
